# Copier ce fichier en .env.local pour le développement local.
# La configuration web Firebase n'est pas secrète : la sécurité repose sur firestore.rules.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optionnel mais recommandé en production : clé de site reCAPTCHA Enterprise pour Firebase App Check
# (protège le formulaire public contre le spam). Laisser vide pour désactiver.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Développement : "true" pour connecter le site aux émulateurs Firebase locaux.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
